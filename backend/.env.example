# Critérios de seleção (Fase 1) — aplicados sobre as ofertas descobertas via
# navegação assistida em data/offers.json (ver README)
MIN_DISCOUNT_PERCENT=30
MIN_RATING=4.3
MAX_RESULTS=5

# ML_ACCESS_TOKEN não é mais necessário para a Fase 1 (descoberta agora é via
# navegador, não pela API de busca — que está bloqueada para apps comuns desde
# abril/2025). Mantido em src/scrapers/mercadolivre.ts como caminho alternativo
# caso o acesso volte a ser liberado.

# Afiliados Mercado Livre — confirmado com um link real do painel
# (mercadolivre.com.br/afiliados): matt_word identifica você como afiliado,
# matt_tool identifica o link/ferramenta. Pegue os seus em qualquer link
# de afiliado gerado no painel deles.
ML_MATT_WORD=
ML_MATT_TOOL=

# Gemini (geração de copy — Fase 2, só texto). Pegue em aistudio.google.com.
GEMINI_API_KEY=
