# Critérios de busca (Fase 1)
ML_SEARCH_QUERY=organizador de casa
ML_CATEGORY_ID=
MIN_DISCOUNT_PERCENT=30
MIN_RATING=4.3
MAX_RESULTS=5

# API do Mercado Livre exige autenticação até para busca (endpoint público
# retorna 403 sem token). Crie uma aplicação em developers.mercadolivre.com.br
# e gere um access_token (fluxo OAuth) para preencher aqui.
ML_ACCESS_TOKEN=

# Afiliados Mercado Livre
# Preencha depois de aprovado no programa (mercadolivre.com.br/afiliados).
# O portal de afiliados gera um parâmetro de rastreio (ex: matt_word / matt_tool)
# para anexar em qualquer link de produto. Cole aqui os nomes/valores exatos
# que aparecerem no seu link de exemplo gerado pelo painel deles.
ML_AFFILIATE_PARAM_NAME=
ML_AFFILIATE_PARAM_VALUE=
